-- COPY AVATAR BY USERNAME (UNIVERSAL)
-- Client-side | Executor Friendly

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CopyAvatarGUI"
ScreenGui.Parent = game.CoreGui

local Frame = Instance.new("Frame")
Frame.Parent = ScreenGui
Frame.Size = UDim2.new(0, 300, 0, 180)
Frame.Position = UDim2.new(0.5, -150, 0.5, -90)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true

local UICorner = Instance.new("UICorner", Frame)
UICorner.CornerRadius = UDim.new(0, 12)

local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Text = "COPY AVATAR"
Title.TextColor3 = Color3.fromRGB(0, 255, 170)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 18

local UsernameBox = Instance.new("TextBox", Frame)
UsernameBox.PlaceholderText = "Masukkan Username"
UsernameBox.Size = UDim2.new(0.9, 0, 0, 40)
UsernameBox.Position = UDim2.new(0.05, 0, 0.3, 0)
UsernameBox.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
UsernameBox.TextColor3 = Color3.new(1,1,1)
UsernameBox.Font = Enum.Font.Gotham
UsernameBox.TextSize = 14
UsernameBox.ClearTextOnFocus = false
Instance.new("UICorner", UsernameBox)

local CopyButton = Instance.new("TextButton", Frame)
CopyButton.Size = UDim2.new(0.9, 0, 0, 40)
CopyButton.Position = UDim2.new(0.05, 0, 0.6, 0)
CopyButton.Text = "COPY AVATAR"
CopyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 120)
CopyButton.TextColor3 = Color3.new(1,1,1)
CopyButton.Font = Enum.Font.GothamBold
CopyButton.TextSize = 14
Instance.new("UICorner", CopyButton)

-- FUNCTION COPY AVATAR
CopyButton.MouseButton1Click:Connect(function()
    local username = UsernameBox.Text
    if username == "" then return end

    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if not success then
        CopyButton.Text = "USERNAME TIDAK DITEMUKAN"
        wait(1.5)
        CopyButton.Text = "COPY AVATAR"
        return
    end

    local description = Players:GetHumanoidDescriptionFromUserId(userId)

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid:ApplyDescription(description)
        CopyButton.Text = "BERHASIL!"
        wait(1.5)
        CopyButton.Text = "COPY AVATAR"
    end
end)
